datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// Organization & Multi-Branch Structure
// ----------------------------------------------------

model Organization {
  id                    String                 @id @default(uuid())
  name                  String
  code                  String                 @unique
  currency              String                 @default("INR")
  taxId                 String?
  address               String?
  phone                 String?
  email                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  branches              Branch[]
  departments           Department[]
  users                 User[]
  products              Product[]
  categories            Category[]
  warehouses            Warehouse[]
  leads                 Lead[]
  customers             Customer[]
  vendors               Vendor[]
  quotations            Quotation[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
  payments              Payment[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]
  goodsReceipts         GoodsReceipt[]
  billsOfMaterials      BillOfMaterials[]
  workOrders            WorkOrder[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  expenses              Expense[]
  budgets               Budget[]
  employees             Employee[]
  payrollRuns           PayrollRun[]
  projects              Project[]
  supportTickets        SupportTicket[]
  auditLogs             AuditLog[]
  approvalRequests      ApprovalRequest[]
  workflowNotifications WorkflowNotification[]
  stockMovements        StockMovement[]
  inventoryReservations InventoryReservation[]
}

model Branch {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String
  address        String?
  city           String?
  state          String?
  country        String         @default("India")
  isHQ           Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  users          User[]
  warehouses     Warehouse[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
  workOrders     WorkOrder[]
  journalEntries JournalEntry[]
  expenses       Expense[]
  employees      Employee[]
  invoices       Invoice[]

  @@unique([organizationId, code])
}

// ----------------------------------------------------
// Users, Roles & Permissions
// ----------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  CEO
  FINANCE_MANAGER
  HR_MANAGER
  SALES_MANAGER
  PROCUREMENT_MANAGER
  INVENTORY_MANAGER
  PRODUCTION_MANAGER
  PROJECT_MANAGER
  EMPLOYEE
}

model User {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?                @relation(fields: [branchId], references: [id])
  name                  String
  email                 String                 @unique
  passwordHash          String                 @default("demo-hash")
  role                  UserRole               @default(EMPLOYEE)
  departmentId          String?
  avatar                String?
  phone                 String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  employeeProfile       Employee?              @relation("UserEmployeeProfile")
  assignedTasks         Task[]                 @relation("AssignedTasks")
  managedProjects       Project[]              @relation("ManagedProjects")
  createdSalesOrders    SalesOrder[]           @relation("CreatedSalesOrders")
  createdPurchaseOrders PurchaseOrder[]        @relation("CreatedPurchaseOrders")
  approvedPurchaseOrders PurchaseOrder[]       @relation("ApprovedPurchaseOrders")
  requestedApprovals    ApprovalRequest[]      @relation("RequestedApprovals")
  assignedApprovals     ApprovalRequest[]      @relation("AssignedApprovals")
  notifications         WorkflowNotification[]
  auditLogs             AuditLog[]
  assignedTickets       SupportTicket[]        @relation("AssignedTickets")
  timeLogs              TimeLog[]
  stockMovements        StockMovement[]
}

// ----------------------------------------------------
// Audit Trails & Approval Workflows
// ----------------------------------------------------

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  entity         String
  entityId       String
  action         String
  previousData   Json?
  newData        Json?
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime     @default(now())
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id              String         @id @default(uuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedBy     User           @relation("RequestedApprovals", fields: [requestedById], references: [id])
  approverId      String?
  approver        User?          @relation("AssignedApprovals", fields: [approverId], references: [id])
  module          String
  entityType      String
  entityId        String
  title           String
  description     String?
  amount          Float?
  status          ApprovalStatus @default(PENDING)
  rejectionReason String?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  ACTION_REQUIRED
}

model WorkflowNotification {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  message        String
  type           NotificationType @default(INFO)
  link           String?
  isRead         Boolean          @default(false)
  createdAt      DateTime         @default(now())
}

// ----------------------------------------------------
// CRM & Sales Management
// ----------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model Lead {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  company        String?
  email          String?
  phone          String?
  status         LeadStatus   @default(NEW)
  estimatedValue Float        @default(0)
  source         String?
  notes          String?
  assignedToId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Customer {
  id                 String          @id @default(uuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String
  name               String
  email              String?
  phone              String?
  company            String?
  taxNumber          String?
  billingAddress     String?
  shippingAddress    String?
  creditLimit        Float           @default(500000)
  outstandingBalance Float           @default(0)
  paymentTermsDays   Int             @default(30)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  quotations         Quotation[]
  salesOrders        SalesOrder[]
  invoices           Invoice[]
  payments           Payment[]
  projects           Project[]
  supportTickets     SupportTicket[]

  @@unique([organizationId, code])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quotationNumber String
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  status         QuotationStatus @default(DRAFT)
  validUntil     DateTime?
  subtotal       Float           @default(0)
  taxAmount      Float           @default(0)
  discountAmount Float           @default(0)
  totalAmount    Float           @default(0)
  notes          String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  items          QuotationItem[]
  salesOrders    SalesOrder[]

  @@unique([organizationId, quotationNumber])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  description String?
  quantity    Float
  unitPrice   Float
  discount    Float     @default(0)
  total       Float
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

model SalesOrder {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?                @relation(fields: [branchId], references: [id])
  orderNumber           String
  customerId            String
  customer              Customer               @relation(fields: [customerId], references: [id])
  quotationId           String?
  quotation             Quotation?             @relation(fields: [quotationId], references: [id])
  status                SalesOrderStatus       @default(DRAFT)
  paymentStatus         PaymentStatus          @default(PENDING)
  subtotal              Float                  @default(0)
  taxAmount             Float                  @default(0)
  discountAmount        Float                  @default(0)
  totalAmount           Float                  @default(0)
  notes                 String?
  createdById           String?
  createdBy             User?                  @relation("CreatedSalesOrders", fields: [createdById], references: [id])
  confirmedAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  items                 SalesOrderItem[]
  invoices              Invoice[]
  inventoryReservations InventoryReservation[]

  @@unique([organizationId, orderNumber])
}

model SalesOrderItem {
  id               String     @id @default(uuid())
  salesOrderId     String
  salesOrder       SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product    @relation(fields: [productId], references: [id])
  description      String?
  quantity         Float
  reservedQuantity Float      @default(0)
  unitPrice        Float
  total            Float
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  invoiceNumber  String
  salesOrderId   String?
  salesOrder     SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  issueDate      DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(ISSUED)
  subtotal       Float         @default(0)
  taxAmount      Float         @default(0)
  totalAmount    Float         @default(0)
  paidAmount     Float         @default(0)
  balanceDue     Float         @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments       Payment[]

  @@unique([organizationId, invoiceNumber])
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CASH
  CHEQUE
  UPI
}

model Payment {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentNumber   String
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  amount          Float
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  paymentDate     DateTime      @default(now())
  notes           String?
  createdById     String?
  createdAt       DateTime      @default(now())

  @@unique([organizationId, paymentNumber])
}

// ----------------------------------------------------
// Inventory & Warehouse Management
// ----------------------------------------------------

enum ProductType {
  RAW_MATERIAL
  WORK_IN_PROGRESS
  FINISHED_GOOD
  CONSUMABLE
  SERVICE
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products       Product[]

  @@unique([organizationId, name])
}

model Product {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId            String?
  category              Category?              @relation(fields: [categoryId], references: [id])
  sku                   String
  name                  String
  description           String?
  unit                  String                 @default("PCS")
  type                  ProductType            @default(FINISHED_GOOD)
  costPrice             Float                  @default(0)
  sellingPrice          Float                  @default(0)
  minStockLevel         Float                  @default(10)
  maxStockLevel         Float                  @default(1000)
  reorderPoint          Float                  @default(20)
  currentStock          Float                  @default(0)
  reservedStock         Float                  @default(0)
  availableStock        Float                  @default(0)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  inventoryReservations InventoryReservation[]
  quotationItems        QuotationItem[]
  salesOrderItems       SalesOrderItem[]
  requisitionItems      PurchaseRequisitionItem[]
  poItems               PurchaseOrderItem[]
  grnItems              GoodsReceiptItem[]
  asFinishedInBOM       BillOfMaterials[]      @relation("BOMFinishedProduct")
  asRawMaterialInBOM    BOMItem[]
  workOrders            WorkOrder[]

  @@unique([organizationId, sku])
}

model Warehouse {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?                @relation(fields: [branchId], references: [id])
  code                  String
  name                  String
  address               String?
  city                  String?
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  stockLevels           StockLevel[]
  stockMovements        StockMovement[]
  inventoryReservations InventoryReservation[]
  goodsReceipts         GoodsReceipt[]
  workOrders            WorkOrder[]

  @@unique([organizationId, code])
}

model StockLevel {
  id               String    @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId        String
  product          Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber      String?
  binLocation      String?
  quantity         Float     @default(0)
  reservedQuantity Float     @default(0)
  updatedAt        DateTime  @updatedAt

  @@unique([warehouseId, productId, batchNumber])
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALES_SHIPMENT
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  type           StockMovementType
  quantity       Float
  unitCost       Float             @default(0)
  totalCost      Float             @default(0)
  referenceType  String?
  referenceId    String?
  batchNumber    String?
  notes          String?
  performedById  String?
  performedBy    User?             @relation(fields: [performedById], references: [id])
  createdAt      DateTime          @default(now())
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
}

model InventoryReservation {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product           @relation(fields: [productId], references: [id])
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  salesOrderId   String?
  salesOrder     SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  workOrderId    String?
  workOrder      WorkOrder?        @relation(fields: [workOrderId], references: [id])
  quantity       Float
  status         ReservationStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// ----------------------------------------------------
// Procurement & Vendor Management
// ----------------------------------------------------

model Vendor {
  id               String          @id @default(uuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code             String
  name             String
  contactPerson    String?
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  paymentTermsDays Int             @default(30)
  rating           Float           @default(5.0)
  bankDetails      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  purchaseOrders   PurchaseOrder[]

  @@unique([organizationId, code])
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model PurchaseRequisition {
  id                   String                    @id @default(uuid())
  organizationId       String
  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requisitionNumber    String
  departmentId         String?
  department           Department?               @relation(fields: [departmentId], references: [id])
  requestedById        String?
  status               RequisitionStatus         @default(DRAFT)
  priority             PriorityLevel             @default(MEDIUM)
  reason               String?
  totalEstimatedAmount Float                     @default(0)
  approvedById         String?
  approvedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  items                PurchaseRequisitionItem[]
  purchaseOrders       PurchaseOrder[]

  @@unique([organizationId, requisitionNumber])
}

model PurchaseRequisitionItem {
  id                 String              @id @default(uuid())
  requisitionId      String
  requisition        PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId          String
  product            Product             @relation(fields: [productId], references: [id])
  quantity           Float
  estimatedUnitPrice Float               @default(0)
  estimatedTotal     Float               @default(0)
}

enum PurchaseOrderStatus {
  DRAFT
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  organizationId       String
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId             String?
  branch               Branch?             @relation(fields: [branchId], references: [id])
  vendorId             String
  vendor               Vendor              @relation(fields: [vendorId], references: [id])
  poNumber             String
  requisitionId        String?
  requisition          PurchaseRequisition? @relation(fields: [requisitionId], references: [id])
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Float               @default(0)
  taxAmount            Float               @default(0)
  totalAmount          Float               @default(0)
  expectedDeliveryDate DateTime?
  shippingAddress      String?
  terms                String?
  createdById          String?
  createdBy            User?               @relation("CreatedPurchaseOrders", fields: [createdById], references: [id])
  approvedById         String?
  approvedBy           User?               @relation("ApprovedPurchaseOrders", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]

  @@unique([organizationId, poNumber])
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Float
  receivedQuantity Float         @default(0)
  unitPrice        Float
  total            Float
}

enum GoodsReceiptStatus {
  PENDING_INSPECTION
  ACCEPTED
  REJECTED
}

model GoodsReceipt {
  id              String             @id @default(uuid())
  organizationId  String
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  purchaseOrderId String
  purchaseOrder   PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  grnNumber       String
  receivedById    String?
  receivedDate    DateTime           @default(now())
  carrier         String?
  trackingNumber  String?
  status          GoodsReceiptStatus @default(ACCEPTED)
  notes           String?
  createdAt       DateTime           @default(now())

  items           GoodsReceiptItem[]

  @@unique([organizationId, grnNumber])
}

model GoodsReceiptItem {
  id               String       @id @default(uuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId        String
  product          Product      @relation(fields: [productId], references: [id])
  orderedQuantity  Float
  receivedQuantity Float
  acceptedQuantity Float
  rejectedQuantity Float        @default(0)
  batchNumber      String?
}

// ----------------------------------------------------
// Manufacturing & Production
// ----------------------------------------------------

model BillOfMaterials {
  id                String       @id @default(uuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  finishedProductId String
  finishedProduct   Product      @relation("BOMFinishedProduct", fields: [finishedProductId], references: [id])
  bomNumber         String
  name              String
  version           String       @default("1.0")
  description       String?
  standardBatchSize Float        @default(1)
  estimatedHours    Float        @default(1)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  items             BOMItem[]
  workOrders        WorkOrder[]

  @@unique([organizationId, bomNumber])
}

model BOMItem {
  id                   String          @id @default(uuid())
  bomId                String
  bom                  BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  rawMaterialProductId String
  rawMaterial          Product         @relation(fields: [rawMaterialProductId], references: [id])
  quantityPerUnit      Float
  scrapPercentage      Float           @default(0)
  unitCost             Float           @default(0)
}

enum WorkOrderStatus {
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id                    String                 @id @default(uuid())
  organizationId        String
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId              String?
  branch                Branch?                @relation(fields: [branchId], references: [id])
  warehouseId           String?
  warehouse             Warehouse?             @relation(fields: [warehouseId], references: [id])
  workOrderNumber       String
  bomId                 String
  bom                   BillOfMaterials        @relation(fields: [bomId], references: [id])
  finishedProductId     String
  finishedProduct       Product                @relation(fields: [finishedProductId], references: [id])
  targetQuantity        Float
  producedQuantity      Float                  @default(0)
  scrappedQuantity      Float                  @default(0)
  status                WorkOrderStatus        @default(PLANNED)
  priority              PriorityLevel          @default(MEDIUM)
  startDate             DateTime?
  dueDate               DateTime?
  completedDate         DateTime?
  totalCost             Float                  @default(0)
  createdById           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  operations            WorkOrderOperation[]
  inventoryReservations InventoryReservation[]

  @@unique([organizationId, workOrderNumber])
}

enum OperationStatus {
  PENDING
  RUNNING
  COMPLETED
}

model WorkOrderOperation {
  id              String          @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sequence        Int
  operationName   String
  workstation     String?
  standardMinutes Float           @default(60)
  actualMinutes   Float           @default(0)
  status          OperationStatus @default(PENDING)
  notes           String?
}

// ----------------------------------------------------
// Finance & Accounting (Double Entry)
// ----------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  NON_CURRENT_ASSET
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  EQUITY
  OPERATING_REVENUE
  NON_OPERATING_REVENUE
  OPERATING_EXPENSE
  COST_OF_GOODS_SOLD
}

model Account {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           AccountType
  subType        AccountSubType
  balance        Float          @default(0)
  isReconciled   Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  journalLines   JournalLine[]

  @@unique([organizationId, code])
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

model JournalEntry {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  entryNumber    String
  entryDate      DateTime      @default(now())
  referenceType  String?
  referenceId    String?
  description    String
  status         JournalStatus @default(POSTED)
  postedById     String?
  postedAt       DateTime?     @default(now())
  createdAt      DateTime      @default(now())

  lines          JournalLine[]

  @@unique([organizationId, entryNumber])
}

model JournalLine {
  id             String       @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Float        @default(0)
  credit         Float        @default(0)
  description    String?
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

model Expense {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id])
  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id])
  title          String
  category       String
  amount         Float
  taxAmount      Float         @default(0)
  totalAmount    Float
  expenseDate    DateTime      @default(now())
  status         ExpenseStatus @default(SUBMITTED)
  receiptUrl     String?
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  requestedById  String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Budget {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department   @relation(fields: [departmentId], references: [id])
  fiscalYear      Int
  quarter         Int?
  allocatedAmount Float
  spentAmount     Float        @default(0)
  remainingAmount Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, departmentId, fiscalYear])
}

// ----------------------------------------------------
// HRMS & Payroll Management
// ----------------------------------------------------

model Department {
  id                   String                @id @default(uuid())
  organizationId       String
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  code                 String
  managerId            String?
  budget               Float                 @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  employees            Employee[]
  expenses             Expense[]
  budgets              Budget[]
  purchaseRequisitions PurchaseRequisition[]

  @@unique([organizationId, code])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum EmployeeStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  TERMINATED
  RESIGNED
}

model Employee {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?        @relation(fields: [branchId], references: [id])
  departmentId   String
  department     Department     @relation(fields: [departmentId], references: [id])
  userId         String?        @unique
  user           User?          @relation("UserEmployeeProfile", fields: [userId], references: [id])
  employeeCode   String
  firstName      String
  lastName       String
  email          String
  phone          String?
  designation    String
  dateOfJoining  DateTime
  employmentType EmploymentType @default(FULL_TIME)
  baseSalary     Float          @default(0)
  allowances     Float          @default(0)
  deductions     Float          @default(0)
  bankAccount    String?
  panNumber      String?
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  payslips       Payslip[]

  @@unique([organizationId, employeeCode])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
  WORK_FROM_HOME
}

model Attendance {
  id             String           @id @default(uuid())
  organizationId String
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  workingHours   Float            @default(8)
  overtimeHours  Float            @default(0)
  notes          String?
  createdAt      DateTime         @default(now())

  @@unique([employeeId, date])
}

enum LeaveType {
  CASUAL
  SICK
  PAID
  UNPAID
  MATERNITY
}

model LeaveRequest {
  id             String         @id @default(uuid())
  organizationId String
  employeeId     String
  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType      @default(PAID)
  startDate      DateTime
  endDate        DateTime
  totalDays      Int            @default(1)
  reason         String?
  status         ApprovalStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  DISBURSED
}

model PayrollRun {
  id                 String        @id @default(uuid())
  organizationId     String
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  month              Int
  year               Int
  status             PayrollStatus @default(DRAFT)
  totalGrossSalary   Float         @default(0)
  totalAllowances    Float         @default(0)
  totalDeductions    Float         @default(0)
  totalNetSalary     Float         @default(0)
  employeeCount      Int           @default(0)
  approvedById       String?
  approvedAt         DateTime?
  disbursedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  payslips           Payslip[]

  @@unique([organizationId, month, year])
}

model Payslip {
  id             String        @id @default(uuid())
  payrollRunId   String
  payrollRun     PayrollRun    @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  baseSalary     Float
  allowances     Float         @default(0)
  deductions     Float         @default(0)
  netSalary      Float
  attendanceDays Int           @default(30)
  leaveDays      Int           @default(0)
  status         PayrollStatus @default(DRAFT)
  paymentDate    DateTime?
  paymentMethod  PaymentMethod @default(BANK_TRANSFER)
  createdAt      DateTime      @default(now())

  @@unique([payrollRunId, employeeId])
}

// ----------------------------------------------------
// Project & Task Management
// ----------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum BillingType {
  FIXED_PRICE
  TIME_AND_MATERIALS
  NON_BILLABLE
}

model Project {
  id             String           @id @default(uuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?        @relation(fields: [customerId], references: [id])
  code           String
  name           String
  description    String?
  status         ProjectStatus    @default(ACTIVE)
  priority       PriorityLevel    @default(MEDIUM)
  startDate      DateTime?
  endDate        DateTime?
  budget         Float            @default(0)
  spentCost      Float            @default(0)
  billingType    BillingType      @default(FIXED_PRICE)
  managerId      String?
  manager        User?            @relation("ManagedProjects", fields: [managerId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  milestones     Milestone[]
  tasks          Task[]
  expenses       ProjectExpense[]

  @@unique([organizationId, code])
}

model Milestone {
  id            String        @id @default(uuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String
  dueDate       DateTime?
  completedDate DateTime?
  amount        Float         @default(0)
  status        ProjectStatus @default(PLANNING)
  createdAt     DateTime      @default(now())
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

model Task {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  assignedToId   String?
  assignedTo     User?         @relation("AssignedTasks", fields: [assignedToId], references: [id])
  priority       PriorityLevel @default(MEDIUM)
  status         TaskStatus    @default(TODO)
  estimatedHours Float         @default(0)
  actualHours    Float         @default(0)
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  timeLogs       TimeLog[]
}

model TimeLog {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  date        DateTime @default(now())
  hours       Float
  description String?
  isBillable  Boolean  @default(true)
  hourlyRate  Float    @default(0)
  createdAt   DateTime @default(now())
}

model ProjectExpense {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  amount      Float
  date        DateTime @default(now())
  isBillable  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ----------------------------------------------------
// Customer Support & Ticketing
// ----------------------------------------------------

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketCategory {
  BILLING
  PRODUCT
  DELIVERY
  TECHNICAL
  GENERAL
}

model SupportTicket {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  ticketNumber   String
  subject        String
  description    String
  priority       PriorityLevel   @default(MEDIUM)
  status         TicketStatus    @default(OPEN)
  category       TicketCategory  @default(GENERAL)
  assignedToId   String?
  assignedTo     User?           @relation("AssignedTickets", fields: [assignedToId], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  messages       TicketMessage[]

  @@unique([organizationId, ticketNumber])
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String?
  senderType String        @default("USER")
  message    String
  createdAt  DateTime      @default(now())
}
